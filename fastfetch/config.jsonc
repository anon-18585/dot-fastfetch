{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/$USER/.config/fastfetch/logo/warp.PNG",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 5,
      "left": 3,
    },
    "color": {
      "1": "#63ffff",
      "2": "#63c6c6",
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": "󰌢  PC",
      "keyColor": "bright_light_white",
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 ",
      "keyColor": "bright_light_white",
    },
    {
      "type": "gpu",
      "key": "│ ├󰍹 ",
      "keyColor": "bright_light_white",
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 ",
      "keyColor": "bright_light_white",
    },
    {
      "type": "disk",
      "key": "└ └󰋊 ",
      "keyColor": "bright_light_white",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "light_white",
    },
    {
      "type": "kernel",
      "key": "│ ├󰌽 ",
      "keyColor": "light_white",
    },
    {
      "type": "bios",
      "key": "│ ├󰖡 ",
      "keyColor": "light_white",
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 ",
      "keyColor": "light_white",
    },
    {
      "type": "shell",
      "key": "└ └󰞷 ",
      "keyColor": "light_white",
    },
    "break",
    {
      "type": "de",
      "key": "󰧨  DE",
      "keyColor": "white",
    },
    {
      "type": "lm",
      "key": "│ ├󰍁 ",
      "keyColor": "white",
    },
    {
      "type": "wm",
      "key": "│ ├󱂬 ",
      "keyColor": "white",
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉦 ",
      "keyColor": "white",
    },
    {
      "type": "terminal",
      "key": "└ └󰆍 ",
      "keyColor": "white",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐",
    },
    {
      "type": "command",
      "key": "  ›  OS Age  ",
      "keyColor": "dim_white",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  ›  Uptime  ",
      "keyColor": "dim_white",
    },
    {
      "type": "datetime",
      "key": "  ›  DateTime  ",
      "keyColor": "dim_white",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
  "display": {
    "color": {
      "keys": "#ffffff",
      "title": "#c6c6c6",
    },
    "percent": {
      "color": {
        "green": "#e2e2e2",
        "yellow": "#474747",
        "red": "#ffb4ab",
      },
    },
  },
}
